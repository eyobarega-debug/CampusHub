DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campushub"
JWT_ACCESS_SECRET="change_me_to_a_long_random_string"
JWT_REFRESH_SECRET="change_me_to_a_different_long_random_string"
TICKET_QR_SECRET="change_me_to_another_long_random_string"
COMMISSION_RATE=0.05
FEATURED_RATE_PER_DAY=20
PORT=4000
NODE_ENV=development

# --- Phase 2 additions ---
# Redis is optional: rate limiting and event-list caching both fall back to
# safe in-process behavior if Redis is unreachable. Install locally with
# `apt-get install redis-server` or point this at a hosted instance.
REDIS_URL="redis://localhost:6379"

# Payment provider selection (src/services/payments.js). "mock" always
# works with no setup. "chapa" requires CHAPA_SECRET_KEY below AND has not
# been tested against the real Chapa API in this project's environment —
# see src/services/providers/chapa.js before enabling it for real payments.
PAYMENT_PROVIDER=mock
CHAPA_SECRET_KEY=
PUBLIC_API_URL="http://localhost:4000"
PUBLIC_APP_URL="http://localhost:5173"
# --- Manual payment with proof ---
MANUAL_PAYMENT_WINDOW_HOURS=24
MANUAL_PROOF_MAX_ATTEMPTS=3

# --- Email OTP verification (src/services/otp.js + src/utils/mailer.js) ---
# SMTP settings used to email the 6-digit signup verification code. Credentials
# are read from the environment ONLY and are never exposed to the frontend.
#
# Leave EMAIL_HOST empty to run locally with zero setup: outgoing mail is then
# printed to the server console as `[DEV EMAIL]` instead of being sent (the same
# "dev pattern" the rest of the repo uses). The OTP is also returned in the
# register/resend response as `devOtp` outside production so you can test the
# flow without an SMTP server.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="CampusHub <no-reply@campushub.local>"

# OTP tuning (optional — defaults shown)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Optional pepper for the stored OTP hash; falls back to JWT_ACCESS_SECRET.
OTP_HASH_SECRET=
