{
  "name": "campushub-backend",
  "version": "1.0.0",
  "description": "CampusHub API (Phase 1 + Phase 2 + Phase 3 merged) — see /docs and the SRS for full context.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:migrate:phase3": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/003_phase3_multitenancy.sql",
    "db:migrate:phase2": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/004_phase2_tenancy.sql",
    "db:migrate:manual": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/005_manual_payments.sql",
    "db:migrate:verification": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/007_campus_verifications.sql",
    "db:migrate:otp": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/009_email_otp.sql",
    "db:migrate:seller": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/010_stores_public_profile.sql",
    "db:migrate:profile": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/011_profile_enhancements.sql",
    "db:migrate:payment-sec": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/012_payment_security_and_currency.sql",
    "db:migrate:isolation": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/013_multitenant_isolation.sql",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:phase3 && npm run db:migrate:phase2 && npm run db:migrate:manual && npm run db:migrate:verification && npm run db:migrate:otp && npm run db:migrate:seller && npm run db:migrate:profile && npm run db:migrate:payment-sec && npm run db:migrate:isolation",
    "db:seed": "node db/seed.js",
    "test:security": "node test/security_phase1.test.js",
    "test:security:phase2": "node test/security_phase2.test.js",
    "test:security:all": "node test/security_phase1.test.js && node test/security_phase2.test.js",
    "test:tenant": "node --test test/tenant_integrity.test.js",
    "test:migration:013": "node --test test/migration_013.test.js",
    "test:tenant:auth": "node --test test/tenant_auth.test.js",
    "test:tenant:routes": "node --test test/tenant_route_scoping.test.js",
    "test:tenant:all": "node --test test/tenant_integrity.test.js test/migration_013.test.js test/tenant_auth.test.js test/tenant_route_scoping.test.js",
    "test:smoke": "bash test/smoke.sh",
    "test:smoke:phase2": "bash test/smoke_phase2.sh",
    "test:tenancy": "bash test/tenancy.sh",
    "test:tenancy:phase2": "bash test/tenancy_phase2.sh"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
